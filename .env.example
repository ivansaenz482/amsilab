# URL pública del sitio (metadata, sitemap y robots)
NEXT_PUBLIC_SITE_URL=https://amsilab.vercel.app

# Base de datos PostgreSQL (Neon / Supabase) para las solicitudes del formulario
DATABASE_URL=postgresql://usuario:clave@host/neondb?sslmode=require

# Sal para anonimizar la IP en el registro de solicitudes (opcional)
LEAD_HASH_SALT=cambia-esta-sal

